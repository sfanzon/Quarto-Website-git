---
import SiteSearch from './SiteSearch.astro';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isAbout = currentPath === '/about';
const isExpertise = currentPath === '/expertise';
const isProjects = currentPath === '/projects' || currentPath.startsWith('/projects/');
const isPublications = currentPath === '/publications';
const isResearch = currentPath === '/research';
const isTeaching = currentPath === '/teaching';
const isNews = currentPath === '/news';
const isContact = currentPath === '/contact';
const isPresentations = currentPath === '/presentations';
const isSupervision = currentPath === '/supervision';
const isNotes = currentPath === '/notes' || currentPath.startsWith('/notes/');
const isCv = currentPath === '/cv';
const isDev = currentPath === '/dev' || currentPath.startsWith('/dev/');
const includeDevTools = import.meta.env.DEV || process.env.SF_INCLUDE_DEV_TOOLS === '1';

const primaryLinks = [
	{ label: 'About', href: '/about/', active: isAbout },
	{ label: 'Projects', href: '/projects/', active: isProjects, section: 'projects' },
	{ label: 'Expertise', href: '/expertise/', active: isExpertise },
	{ label: 'CV', href: '/cv/', active: isCv },
	{ label: 'Publications', href: '/publications/', active: isPublications },
	{ label: 'Teaching', href: '/teaching/', active: isTeaching },
	{ label: 'News', href: '/news/', active: isNews },
];

const dropdowns = [
	{
		label: 'More',
		active: isNotes || isResearch || isPresentations || isSupervision || isContact,
		links: [
			{ label: 'Notes', href: '/notes/', active: isNotes },
			{ label: 'Research', href: '/research/', active: isResearch },
			{ label: 'Presentations', href: '/presentations/', active: isPresentations },
			{ label: 'Supervision', href: '/supervision/', active: isSupervision },
			{ label: 'Contact', href: '/contact/', active: isContact },
		],
	},
	...(includeDevTools ? [{
		label: 'Dev',
		active: isDev,
		links: [
			{ label: 'Astro kitchen sink', href: '/dev/kitchen-sink/' },
			{ label: 'Quarto kitchen sink', href: '/dev/quarto-kitchen-sink.html' },
			{ label: 'Viewports', href: '/dev/viewports/' },
		],
	}] : []),
];
---

<header class="site-header">
	<nav class="site-navbar" aria-label="Primary navigation">
		<a class="site-brand" href="/">Silvio Fanzon</a>

		<div class="navbar-links" id="navbar-links">
			{primaryLinks.map((link) => (
				<a
					href={link.href}
					data-nav-section={link.section}
					class:list={{ active: link.active }}
					aria-current={link.active ? 'page' : undefined}
				>
					<span>{link.label}</span>
				</a>
			))}
			{dropdowns.map((dropdown) => (
				<details class="navbar-menu-dropdown" data-navbar-dropdown>
					<summary
						class:list={{ active: dropdown.active }}
						aria-current={dropdown.active ? 'page' : undefined}
					>
						<span>{dropdown.label}</span>
					</summary>
					<div class="navbar-dropdown">
						{dropdown.links.map((link) => (
							<a
								href={link.href}
								class:list={{ active: link.active }}
								aria-current={link.active ? 'page' : undefined}
							>
								<span>{link.label}</span>
							</a>
						))}
					</div>
				</details>
			))}
		</div>

		<div class="navbar-controls">
			<SiteSearch />
			<button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch colour theme">
			</button>
			<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="navbar-links">
				<span class="menu-icon" aria-hidden="true"></span>
			</button>
		</div>
	</nav>
</header>

<script>
	const initialiseShell = () => {
		const root = document.documentElement;
		const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
		const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
		const navLinks = document.querySelector<HTMLElement>('#navbar-links');
		const projectsLink = navLinks?.querySelector<HTMLAnchorElement>('[data-nav-section="projects"]');
		const quartoToggle = () => (window as Window & { quartoToggleColorScheme?: () => void }).quartoToggleColorScheme;

		const setThemeLabel = () => {
			const dark = root.dataset.theme === 'dark';
			const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
			themeButton?.setAttribute('aria-label', label);
			themeButton?.setAttribute('title', label);
		};

		const syncQuartoTheme = () => {
			const dark = document.body.classList.contains('quarto-dark');
			root.dataset.theme = dark ? 'dark' : 'light';
			root.style.colorScheme = dark ? 'dark' : 'light';
			localStorage.setItem('theme', dark ? 'dark' : 'light');
			setThemeLabel();
		};

		themeButton?.addEventListener('click', () => {
			const toggle = quartoToggle();
			if (toggle) {
				toggle();
				syncQuartoTheme();
				return;
			}
			const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
			root.dataset.theme = theme;
			root.style.colorScheme = theme;
			localStorage.setItem('theme', theme);
			setThemeLabel();
		});

		menuButton?.addEventListener('click', () => {
			const open = menuButton.getAttribute('aria-expanded') !== 'true';
			menuButton.setAttribute('aria-expanded', String(open));
			menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			navLinks?.classList.toggle('is-open', open);
		});

		const desktopDropdown = () => window.matchMedia('(min-width: 992px) and (hover: hover)').matches;
		const dropdowns = [...(navLinks?.querySelectorAll<HTMLDetailsElement>('[data-navbar-dropdown]') ?? [])];
		const closeOtherDropdowns = (current: HTMLDetailsElement) => {
			dropdowns.forEach((dropdown) => {
				if (dropdown !== current) dropdown.open = false;
			});
		};
		const setupNavbarDropdown = (dropdown: HTMLDetailsElement) => {
			const summary = dropdown.querySelector<HTMLElement>('summary');
			let closeTimer: number | undefined;
			let openedByHover = false;
			const clearCloseTimer = () => {
				if (closeTimer !== undefined) window.clearTimeout(closeTimer);
				closeTimer = undefined;
			};

			dropdown.addEventListener('pointerenter', () => {
				if (!desktopDropdown()) return;
				clearCloseTimer();
				if (!dropdown.open) {
					closeOtherDropdowns(dropdown);
					dropdown.open = true;
					openedByHover = true;
				}
			});
			dropdown.addEventListener('toggle', () => {
				if (dropdown.open) {
					closeOtherDropdowns(dropdown);
					return;
				}
				openedByHover = false;
				clearCloseTimer();
			});
			dropdown.addEventListener('pointerleave', () => {
				if (!desktopDropdown()) return;
				clearCloseTimer();
				closeTimer = window.setTimeout(() => {
					dropdown.open = false;
					openedByHover = false;
				}, 120);
			});
			summary?.addEventListener('click', (event) => {
				if (!desktopDropdown() || !dropdown.open || !openedByHover) return;
				event.preventDefault();
				openedByHover = false;
			});
			dropdown.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape' || !dropdown.open) return;
				event.preventDefault();
				dropdown.open = false;
				openedByHover = false;
				summary?.focus();
			});
		};

		dropdowns.forEach(setupNavbarDropdown);

		const toggle = quartoToggle();
		const path = window.location.pathname.replace(/\/+$/, '') || '/';
		const projectsActive = path === '/projects' || path.startsWith('/projects/');
		projectsLink?.classList.toggle('active', projectsActive);
		if (projectsActive) projectsLink?.setAttribute('aria-current', 'page');
		else projectsLink?.removeAttribute('aria-current');
		if (toggle) {
			const requested = localStorage.getItem('theme');
			const currentDark = document.body.classList.contains('quarto-dark');
			if ((requested === 'dark' || requested === 'light') && (requested === 'dark') !== currentDark) toggle();
			syncQuartoTheme();
		} else {
			setThemeLabel();
		}
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initialiseShell, { once: true });
	} else {
		initialiseShell();
	}
</script>
