<button class="back-to-top" type="button" aria-label="Back to top" aria-hidden="true" tabindex="-1">
	<span aria-hidden="true">↑</span>
</button>

<script>
	const initialiseBackToTop = () => {
		const button = document.querySelector<HTMLButtonElement>('.back-to-top');
		if (!button || button.dataset.initialised === 'true') return;
		button.dataset.initialised = 'true';
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const footer = document.querySelector<HTMLElement>('.site-footer');
		let docked = false;
		let fixedInset = 18;
		const positionAtFooter = () => {
			if (!footer) return;
			const footerTop = footer.getBoundingClientRect().top + window.scrollY;
			button.style.top = `${footerTop - button.offsetHeight - fixedInset}px`;
		};
		const setDocked = (shouldDock: boolean) => {
			if (!footer || shouldDock === docked) return;
			docked = shouldDock;
			button.classList.toggle('is-docked', docked);
			if (docked) {
				positionAtFooter();
			} else {
				button.style.removeProperty('top');
			}
		};
		const updatePosition = (repositionDocked = false) => {
			const visible = window.scrollY >= 600;
			button.classList.toggle('is-visible', visible);
			button.setAttribute('aria-hidden', String(!visible));
			button.tabIndex = visible ? 0 : -1;
			if (!footer) return;
			if (!docked) fixedInset = Number.parseFloat(getComputedStyle(button).bottom) || fixedInset;
			setDocked(footer.getBoundingClientRect().top <= window.innerHeight);
			if (repositionDocked && docked) positionAtFooter();
		};
		button.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
		});
		window.addEventListener('scroll', () => updatePosition(), { passive: true });
		window.addEventListener('resize', () => updatePosition(true));
		updatePosition();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initialiseBackToTop, { once: true });
	} else {
		initialiseBackToTop();
	}
</script>
