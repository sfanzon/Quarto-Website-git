<script>
	import renderMathInElement from 'katex/contrib/auto-render';

	const initialiseDisclosureArchives = () => {
		document.querySelectorAll<HTMLElement>('[data-disclosure-archive]').forEach((archive) => {
			if (archive.dataset.initialised === 'true') return;
			archive.dataset.initialised = 'true';
			archive.querySelectorAll<HTMLButtonElement>('.abstract-toggle').forEach((button) => {
				const entry = button.closest<HTMLElement>('.publication-entry');
				const panel = entry?.querySelector<HTMLElement>('.abstract');
				if (!entry || !panel) return;
				panel.id ||= `${entry.id}-abstract`;
				panel.classList.remove('hidden');
				panel.hidden = true;
				button.setAttribute('aria-controls', panel.id);
				button.setAttribute('aria-expanded', 'false');
				button.addEventListener('click', () => {
					const opening = panel.hidden;
					panel.hidden = !opening;
					panel.classList.toggle('open', opening);
					button.setAttribute('aria-expanded', String(opening));
					if (opening && panel.dataset.mathRendered !== 'true') {
						renderMathInElement(panel, {
							delimiters: [
								{ left: '\\(', right: '\\)', display: false },
								{ left: '\\[', right: '\\]', display: true },
							],
							throwOnError: false,
						});
						panel.dataset.mathRendered = 'true';
					}
				});
			});
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initialiseDisclosureArchives, { once: true });
	} else {
		initialiseDisclosureArchives();
	}
</script>
