---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PublicationArchive from '../components/PublicationArchive.astro';
import '../styles/publications.css';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Publications | Silvio Fanzon"
			description="Selected and complete publication list of Silvio Fanzon"
		/>
	</head>
	<body class="standard-page publications-page">
		<Header />
		<main class="content">
			<header class="page-hero compact-page-hero publications-hero">
				<h1>Publications</h1>
				<p>Research in optimisation, inverse problems, partial differential equations and statistical modelling, with applications in imaging and sports analytics.</p>
			</header>

			<section class="publication-section all-publications" aria-label="Publication list">
				<nav class="section-jump" aria-label="Publication categories">
					<a href="#journal-publications">Journal publications</a>
					<a href="#theses">Theses</a>
					<a href="#miscellaneous">Miscellaneous</a>
				</nav>
				<PublicationArchive />
			</section>
		</main>
		<Footer />
	</body>
</html>
