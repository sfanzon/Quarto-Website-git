---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/archive-actions.css';
---
<!doctype html>
<html lang="en">
	<head><BaseHead title="Page not found | Silvio Fanzon" description="The requested page could not be found" /></head>
	<body class="standard-page not-found-page">
		<Header />
		<main class="content">
			<header class="page-hero compact-page-hero"><p class="eyebrow">404</p><h1>Page not found</h1><p>The page may have moved, or the address may be incorrect.</p></header>
			<nav class="paper-actions" aria-label="Continue browsing"><a class="paper-action" href="/">Return home</a><a class="paper-action" href="/projects/">Explore projects</a></nav>
		</main>
		<Footer />
	</body>
</html>
