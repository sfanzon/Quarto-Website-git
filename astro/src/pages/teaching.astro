---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/teaching.css';
import '../styles/section-jump.css';

const source = [
	resolve(process.cwd(), '../includes/teaching-list.html'),
	resolve(process.cwd(), 'includes/teaching-list.html'),
].find(existsSync);

if (!source) throw new Error('Unable to locate generated includes/teaching-list.html');
const teachingList = readFileSync(source, 'utf8');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Teaching | Silvio Fanzon" description="Teaching, course materials and student supervision" />
	</head>
	<body class="standard-page teaching-page">
		<Header />
		<main class="content">
			<header class="page-hero compact-page-hero teaching-hero">
				<h1>Teaching</h1>
				<p>I teach across statistics, applied mathematics and pure mathematics, with an emphasis on clear exposition, problem solving and reproducible computational work.</p>
			</header>
			<section class="teaching-intro">
				<p>Selected notes, slides, revision guides and course pages are linked below. Materials may be reused for teaching with attribution.</p>
			</section>
			<nav class="section-jump teaching-jump" aria-label="Teaching sections">
				<a href="#lecturer">Lecturer</a>
				<a href="#tutor">Teaching assistant</a>
			</nav>
			<div class="teaching-list" set:html={teachingList} />
		</main>
		<Footer />
		<script>
			const initialiseTeaching = () => {
				document.querySelectorAll<HTMLButtonElement>('.teaching-list .abstract-toggle').forEach((button) => {
					const course = button.closest<HTMLElement>('.teaching-course');
					const panel = course?.querySelector<HTMLElement>('.abstract');
					if (!course || !panel) return;
					panel.id ||= `${course.id}-about`;
					panel.classList.remove('hidden');
					panel.hidden = true;
					button.setAttribute('aria-controls', panel.id);
					button.setAttribute('aria-expanded', 'false');
					button.addEventListener('click', () => {
						const opening = panel.hidden;
						panel.hidden = !opening;
						panel.classList.toggle('open', opening);
						button.setAttribute('aria-expanded', String(opening));
					});
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initialiseTeaching, { once: true });
			} else {
				initialiseTeaching();
			}
		</script>
	</body>
</html>
