---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/home.css';
import '../styles/news-component.css';

const newsSource = [
	resolve(process.cwd(), '../includes/home-news.html'),
	resolve(process.cwd(), 'includes/home-news.html'),
].find(existsSync);

if (!newsSource) throw new Error('Unable to locate generated includes/home-news.html');
const homeNews = readFileSync(newsSource, 'utf8');
---
<!doctype html>
<html lang="en">
<head><BaseHead title="Silvio Fanzon" description="Silvio Fanzon — applied mathematics, statistical modelling, optimisation and scientific computing" /></head>
<body class="home-page">
<Header />
<main class="content home-content">
<section class="home-hero">
<img class="home-portrait" src="/assets/img/profile/silvioimg.png" alt="Portrait of Silvio Fanzon" fetchpriority="high" />
<div class="home-intro">
<div class="home-name" role="heading" aria-level="1">Silvio Fanzon <span class="home-degree">PhD</span></div>
<p class="home-role"><span>Applied mathematician · Statistical modeller</span></p>
<div class="home-bio-copy"><p class="home-lead">I build interpretable models, optimisation methods and reproducible computational tools for complex systems.</p><p class="home-summary">My work connects data science, operational research and scientific computing, with applications in medical imaging, sports analytics and decision-making under uncertainty.</p></div>
<nav class="home-profile-links" aria-label="Profile links"><a href="mailto:silvio.fanzon.work@gmail.com">Email</a><a href="https://www.silviofanzon.com/Silvio_Fanzon_Academic_CV.pdf">CV</a><a href="https://www.linkedin.com/in/fanzon" target="_blank" rel="noopener">LinkedIn</a><a href="https://github.com/sfanzon" target="_blank" rel="noopener">GitHub</a><a href="https://scholar.google.com/citations?user=9yJyLsoAAAAJ" target="_blank" rel="noopener">Scholar</a><a href="/contact/">Contact</a></nav>
</div>
<a class="home-scroll-cue" href="#home-expertise-title" aria-label="Explore the rest of the homepage"><span>Explore my work</span><span class="home-scroll-arrow" aria-hidden="true">↓</span></a>
</section>
<section class="home-section home-expertise-preview" aria-labelledby="home-expertise-title"><div class="expertise-preview-header"><div><p class="eyebrow">Expertise</p><h2 id="home-expertise-title">What I bring to complex problems</h2><p>A capability-led view of the modelling, computation and communication skills behind my research and applied work.</p></div><a class="section-link" href="/expertise/">Explore my expertise →</a></div><div class="expertise-preview-grid">
<a class="expertise-preview-item" href="/expertise/#statistical-modelling"><span>01</span><h3>Statistical modelling</h3><p>Interpretable models for prediction, ranking, forecasting and uncertainty.</p></a>
<a class="expertise-preview-item" href="/expertise/#optimisation"><span>02</span><h3>Optimisation &amp; decision science</h3><p>Methods for choosing well under constraints, uncertainty and limited information.</p></a>
<a class="expertise-preview-item" href="/expertise/#scientific-computing"><span>03</span><h3>Scientific computing</h3><p>Numerical implementation, simulation and reproducible computational workflows.</p></a>
<a class="expertise-preview-item" href="/expertise/#inverse-problems"><span>04</span><h3>Inverse problems &amp; imaging</h3><p>Recovering useful structure from incomplete, indirect or noisy observations.</p></a>
<a class="expertise-preview-item" href="/expertise/#communication-leadership"><span>05</span><h3>Communication &amp; leadership</h3><p>Clear documentation, programme delivery, collaboration and technical mentoring.</p></a>
</div></section>
<section class="home-section home-editorial-section home-projects-section"><div class="section-heading"><div><p class="eyebrow">Projects</p><h2>Selected work</h2><p class="section-intro">Three examples showing modelling, implementation and communication—not only technical mathematics.</p></div><a class="section-link" href="/projects/">View all projects →</a></div><div class="home-project-grid">
<article class="home-project-card"><div class="home-project-visual"><img src="/assets/img/projects/f1-benchmarking.svg" alt="Abstract visual for Who’s actually the best F1 driver?"></div><div class="home-project-copy"><p class="project-labels">Statistical modelling · Sports analytics · R</p><h3>Who’s actually the best F1 driver?</h3><p>An industry-facing explanation of how 2022 race results and 2023 betting odds separate driver performance from constructor advantage.</p><div class="home-project-actions"><a href="/projects/f1-time-rank-duality/">Read project <span aria-hidden="true">→</span></a><a href="https://github.com/sfanzon/F1-Paper-Code">Code</a></div></div></article>
<article class="home-project-card"><div class="home-project-visual"><img src="/assets/img/projects/sparse-gcg.svg" alt="Abstract visual for Sparse optimisation with FC-GCG"></div><div class="home-project-copy"><p class="project-labels">Optimisation · Algorithms · Python</p><h3>Sparse optimisation with FC-GCG</h3><p>A visual pedagogical implementation showing how fully-corrective conditional gradients build sparse solutions one atom at a time.</p><div class="home-project-actions"><a href="https://www.silviofanzon.com/projects/sparse-gcg/index.html">Read project <span aria-hidden="true">→</span></a><a href="https://github.com/sfanzon/sparse-gcg-paper-explainer">Code</a></div></div></article>
<article class="home-project-card"><div class="home-project-visual"><img src="/assets/img/projects/teaching.svg" alt="Abstract visual for An applied statistical modelling course"></div><div class="home-project-copy"><p class="project-labels">Statistics · Teaching · R</p><h3>An applied statistical modelling course</h3><p>A complete R-based learning system combining lectures, worked examples, practical exercises and accessible digital publishing.</p><div class="home-project-actions"><a href="https://www.silviofanzon.com/blog/2026/Statistical-Models/">Read project <span aria-hidden="true">→</span></a></div></div></article>
</div></section>
<section class="home-section home-editorial-section home-approach-section" aria-labelledby="home-approach-title"><div class="section-heading"><div><p class="eyebrow">Approach</p><h2 id="home-approach-title">From a difficult question to a defensible result</h2><p class="section-intro">I work from problem formulation through modelling, implementation and validation to clear communication. The standard is consistent across the work: make assumptions visible, build reproducibly, test what the evidence supports and explain the result clearly.</p></div><a class="section-link" href="/about/">About how I work →</a></div><div class="about-capabilities" aria-label="How I work"><article><span>01</span><h3>Frame the problem</h3><p>Turn an open-ended question into assumptions, objectives, constraints and measurable outcomes.</p></article><article><span>02</span><h3>Build and test</h3><p>Translate mathematical and statistical ideas into models, algorithms and reproducible computational experiments.</p></article><article><span>03</span><h3>Explain clearly</h3><p>Communicate the substance for technical, professional and wider audiences without hiding assumptions or unnecessary complexity.</p></article><article><span>04</span><h3>Lead collaboratively</h3><p>Coordinate programmes and projects, mentor researchers, build collaborations and connect people with different expertise.</p></article></div></section>
<section class="home-section home-notes-section home-editorial-section"><div class="section-heading"><div><p class="eyebrow">Notes</p><h2>Selected notes</h2><p class="section-intro">Practical writing on AI-assisted technical work, scope, verification and agent workflows.</p></div><a class="section-link" href="/notes/">View all notes →</a></div><div class="home-notes-list">
<article class="home-note-row"><a class="home-note-row-visual" href="/notes/how-i-use-ai.html" aria-label="Read How I use AI in technical work"><img src="/assets/img/notes/ai-agent-stack.svg" alt="A five-layer diagram of an AI agent workflow, from model to human review"></a><div class="home-note-row-copy"><div class="home-note-row-meta"><time>30 July 2026</time><span>AI · Workflow · Research</span></div><h3><a href="/notes/how-i-use-ai.html">How I use AI in technical work</a></h3><p>A practical account of how I use AI across research, scientific computing and technical communication: where it adds leverage, where I retain control, and how I verify what matters.</p><a class="home-note-row-link" href="/notes/how-i-use-ai.html">Read note <span aria-hidden="true">→</span></a></div></article>
<article class="home-note-row"><a class="home-note-row-visual" href="/notes/ai-real-project-lessons.html" aria-label="Read What I Learned From Letting AI Work on a Real Project"><img src="/assets/img/notes/scope-control.svg" alt="A bounded technical task contrasted with expanding scope and complexity"></a><div class="home-note-row-copy"><div class="home-note-row-meta"><time>30 July 2026</time><span>AI · Workflow · Research</span></div><h3><a href="/notes/ai-real-project-lessons.html">What I Learned From Letting AI Work on a Real Project</a></h3><p>A practical framework for using AI on serious technical work without losing control of the problem.</p><a class="home-note-row-link" href="/notes/ai-real-project-lessons.html">Read note <span aria-hidden="true">→</span></a></div></article>
<article class="home-note-row"><a class="home-note-row-visual" href="/notes/ai-agents-practical-stack-2026-qwen9-128k-copilot-opencode-no-gemini-free.html" aria-label="Read From Chatbots to Agents: How I Built My AI Stack in 2026"><img src="/assets/img/notes/agent-stack-evolution.svg" alt="A progression from chatbot to coding assistant, agent, workflow and automation"></a><div class="home-note-row-copy"><div class="home-note-row-meta"><time>26 July 2026</time><span>AI · Tools · Workflow</span></div><h3><a href="/notes/ai-agents-practical-stack-2026-qwen9-128k-copilot-opencode-no-gemini-free.html">From Chatbots to Agents: How I Built My AI Stack in 2026</a></h3><p>A practical account of how I moved from using ChatGPT as a chatbot to building a working stack around Codex, OpenCode, DeepSeek, OpenClaw and automation.</p><a class="home-note-row-link" href="/notes/ai-agents-practical-stack-2026-qwen9-128k-copilot-opencode-no-gemini-free.html">Read note <span aria-hidden="true">→</span></a></div></article>
</div></section>
<section class="home-section selected-publications-section home-editorial-section"><div class="section-heading"><div><p class="eyebrow">Publications</p><h2>Research outputs</h2><p class="section-intro">Selected work spanning optimisation, statistical modelling, inverse problems and applied mathematics.</p></div><a class="section-link" href="/publications/">View all publications →</a></div><div class="home-publications-list">
<article class="home-publication-row"><div class="publication-theme-rail"><span>Statistical modelling</span><span>Sports analytics</span></div><div class="home-publication-main"><h3>Benchmarking Formula 1 results using a normal model</h3><div class="paper-meta"><span>John Fry, <u>Silvio Fanzon</u>, Mark Austin and Tom Brighton</span><span><em>ArXiv Preprint</em> · 2026</span></div><div class="paper-actions"><a href="https://www.silviofanzon.com/assets/pdf/journal/2026-Fry-Fan-Aus-Bri.pdf">PDF</a><a href="https://arxiv.org/abs/2603.15192">arXiv</a><details><summary>Abstract</summary><p>There is enduring interest in disentangling the effects of skill and luck in sport. A key issue in Formula 1 is distinguishing between car-level and driver-level effects. Four elite teams currently dominate Formula 1 and have won every major race for the last four years.</p></details><details><summary>Cite</summary><pre><code>@article&#123;2026-Fry-Fan-Aus-Bri, title = &#123;Benchmarking Formula 1 results using a normal model&#125;, author = &#123;Fry, John and Fanzon, Silvio and Austin, Mark and Brighton, Tom&#125;, year = &#123;2026&#125;&#125;</code></pre></details></div></div></article>
<article class="home-publication-row"><div class="publication-theme-rail"><span>Optimisation</span><span>Numerical algorithms</span></div><div class="home-publication-main"><h3>Asymptotic linear convergence of Fully–Corrective Generalized Conditional Gradient methods</h3><div class="paper-meta"><span>Kristian Bredies, Marcello Carioni, <u>Silvio Fanzon</u> and Daniel Walter</span><span><em>Mathematical Programming</em> · 2024</span></div><div class="paper-actions"><a href="https://www.silviofanzon.com/assets/pdf/journal/2024-Bre-Car-Fan-Wal.pdf">PDF</a><a href="https://doi.org/10.1007/s10107-023-01975-z">Journal</a><details><summary>Abstract</summary><p>We propose a fully-corrective generalized conditional gradient method for the minimization of a smooth convex loss and a convex one-homogeneous regularizer over a Banach space. Under standard hypotheses we show that the algorithm converges sublinearly, subsequently improving this to a linear rate.</p></details><a href="https://www.silviofanzon.com/projects/sparse-gcg/index.html">Explainer</a><a href="https://github.com/sfanzon/sparse-gcg-paper-explainer">Code</a><a href="https://www.silviofanzon.com/assets/pdf/journal/slides/2024-Bre-Car-Fan-Wal-Slides-Short.pdf">Slides</a></div></div></article>
<article class="home-publication-row"><div class="publication-theme-rail"><span>Statistical modelling</span><span>Sports analytics</span></div><div class="home-publication-main"><h3>Faster identification of faster Formula 1 drivers via time-rank duality</h3><div class="paper-meta"><span>John Fry, Tom Brighton and <u>Silvio Fanzon</u></span><span><em>Economics Letters</em> · 2024</span></div><div class="paper-actions"><a href="https://www.silviofanzon.com/assets/pdf/journal/2024-Fry-Bri-Fan.pdf">PDF</a><a href="https://doi.org/10.1016/j.econlet.2024.111671">Journal</a><details><summary>Abstract</summary><p>Two natural ways of modelling Formula 1 race outcomes are a probabilistic approach, based on the exponential distribution, and econometric modelling of the ranks. Both approaches lead to exactly soluble race-winning probabilities.</p></details><a href="/projects/f1-time-rank-duality/">Explainer</a><a href="https://github.com/sfanzon/F1-Paper-Code">Code</a></div></div></article>
<article class="home-publication-row"><div class="publication-theme-rail"><span>Inverse problems</span><span>Optimal transport</span></div><div class="home-publication-main"><h3>A Generalized Conditional Gradient Method for Dynamic Inverse Problems with Optimal Transport Regularization</h3><div class="paper-meta"><span>Kristian Bredies, Marcello Carioni, <u>Silvio Fanzon</u> and Francisco Romero</span><span><em>Foundations of Computational Mathematics</em> · 2023</span></div><div class="paper-actions"><a href="https://www.silviofanzon.com/assets/pdf/journal/2023-Bre-Car-Fan-Rom.pdf">PDF</a><a href="https://doi.org/10.1007/s10208-022-09561-z">Journal</a><details><summary>Abstract</summary><p>We develop a dynamic generalized conditional gradient method for dynamic inverse problems with optimal transport regularization. We propose a dynamic generalization and prove sublinear convergence.</p></details><a href="https://github.com/sfanzon/DGCG_algorithm">Code</a><a href="https://www.silviofanzon.com/assets/pdf/journal/poster/2023-Bre-Car-Fan-Rom-Poster.pdf">Poster</a><a href="https://youtu.be/wO8j1fSpd-k">Video</a></div></div></article>
</div></section>
<section class="home-section news-preview home-editorial-section"><div class="section-heading"><div><p class="eyebrow">News</p><h2>Latest updates</h2><p class="section-intro">Recent updates on research, publications, software, teaching and professional activity.</p></div><a class="section-link" href="/news/">View all news →</a></div><div set:html={homeNews} /></section>
<section class="home-section home-background-section"><div class="home-background-copy"><p class="eyebrow">Background</p><h2>A research career across the UK and Austria</h2><p>My approach was shaped by an EPSRC-funded PhD at the University of Sussex, postdoctoral research in motion-aware medical imaging at the University of Graz, and faculty roles in Austria and the UK.</p><p>At the University of Hull I held a permanent Lecturer in Applied Mathematics post—the UK academic grade closest to Assistant Professor—and served as Programme Director for the MSc in Mathematics. That career also developed my skills in leadership, collaboration, supervision, technical documentation and communication.</p></div><a class="section-link" href="/about/">About my background →</a></section>
</main>
<Footer />
<script>
	const portrait = document.querySelector<HTMLImageElement>('.home-portrait');
	if (portrait) {
		const revealPortrait = () => portrait.classList.add('is-loaded');
		if (portrait.complete && portrait.naturalWidth > 0) revealPortrait();
		else portrait.addEventListener('load', revealPortrait, { once: true });
	}

</script>
</body>
</html>
