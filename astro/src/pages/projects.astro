---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { projects } from '../data/projects';
import '../styles/projects.css';

const siteUrl = 'https://www.silviofanzon.com';
const hrefFor = (href: string) => href.startsWith('/') ? href : href.startsWith('projects/') ? `/${href}` : href === 'index.html' ? '/' : href === 'publications.html' ? '/publications/' : href.startsWith('http') ? href : `${siteUrl}/${href}`;
const imageFor = (image: string) => image.startsWith('/') ? image : `/${image}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Projects | Silvio Fanzon" description="Selected modelling, optimisation, research software, documentation and communication projects by Silvio Fanzon" />
	</head>
	<body class="standard-page projects-page">
		<Header />
		<main class="content">
			<header class="page-hero compact-page-hero projects-hero">
				<p class="eyebrow">Projects</p>
				<h1>Evidence of how I work</h1>
				<p>Selected examples showing problem formulation, modelling, implementation, evaluation and communication—not only technical mathematics.</p>
			</header>
			<section class="projects-positioning" aria-label="About these projects">
				<p><strong>Expertise</strong> describes my transferable capabilities. <strong>Research</strong> explains the academic contributions. <strong>Projects</strong> makes the work inspectable through code, experiments, documentation and plain-language explanations.</p>
			</section>
			<section class="projects-section project-portfolio">
				<div class="section-heading project-page-heading"><div><p class="eyebrow">Selected work</p><span>Projects, implementations and reproducible outputs</span></div></div>
				<div class="projects-card-grid">
					{projects.map((project) => (
						<article class:list={['home-project-card', 'project-summary-card', project.archived && 'project-summary-card-archive']}>
							<div class="home-project-visual"><img src={imageFor(project.image)} alt={`Abstract visual for ${project.title}`} /></div>
							<div class="home-project-copy">
								<p class="project-labels">{project.labels.slice(0, 3).join(' · ')}</p>
								<h3>{project.title}</h3>
								<p>{project.summary}</p>
								<div class="home-project-actions"><a href={hrefFor(project.href)}>Read project <span aria-hidden="true">→</span></a>{project.code && <a href={project.code}>Code</a>}</div>
							</div>
						</article>
					))}
				</div>
			</section>
			<section class="project-capabilities">
				<div class="section-heading"><div><p class="eyebrow">What the portfolio shows</p><h2>More than technical mathematics</h2></div></div>
				<div class="capability-grid">
					<article><h3>Problem formulation</h3><p>Turning ambiguous scientific or applied questions into explicit assumptions, models and measurable outputs.</p></article>
					<article><h3>Implementation</h3><p>Building reproducible numerical and statistical workflows in Python, R and MATLAB.</p></article>
					<article><h3>Evaluation</h3><p>Comparing methods, checking sensitivity, stating limitations and distinguishing evidence from interpretation.</p></article>
					<article><h3>Communication</h3><p>Writing for technical and non-technical audiences through papers, documentation, teaching and visual explanation.</p></article>
					<article><h3>Leadership</h3><p>Coordinating programmes and research projects, mentoring junior researchers and collaborating internationally.</p></article>
					<article><h3>Delivery</h3><p>Producing inspectable outputs: code, figures, reports, learning systems and maintained digital resources.</p></article>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
